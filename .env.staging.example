# PawFlow API: STAGING configuration template (P3-BE11)
#
# Copy to the deployment's secret store or to `.env.staging` (git-ignored),
# replace EVERY <placeholder>, never commit real values. The application
# refuses to start when a rule below is violated; the error names the
# variable, never its value. Validate locally with:
#   NODE_ENV=staging ... node dist/main.js   (or see docs/phase3/p3-be11-staging-runbook.md)

NODE_ENV=staging
PORT=8000

# --- Database: dedicated staging database and least-privilege role (DML only) ---
# Never the development database (pet_care_db) or a superuser (postgres/admin/root).
# Migrations run separately with a migration-owner role (see the runbook).
DB_HOST=<staging-db-host>
DB_PORT=5432
DB_USERNAME=<pawflow_staging_app>
DB_PASSWORD=<generated, >= 12 chars>
DB_DATABASE=<pawflow_staging>
# require (TLS, certificate verified) | no-verify (TLS, unverified) | disable (same-host loopback only)
DB_SSL=require
# Refuse to start unless the database is at this build's migration level (default in staging).
MIGRATIONS_CHECK=enforce

# --- Secrets (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ---
JWT_SECRET=<random, >= 32 chars>
RATE_LIMIT_HASH_SECRET=<random, >= 32 chars, different from JWT_SECRET>
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000

# --- Browser access, proxy, HTTPS ---
# Exact https origins of the staging frontend; no wildcard, no localhost, no path.
CORS_ORIGINS=https://<staging-frontend-host>
# Peers allowed to set X-Forwarded-For / X-Forwarded-Proto. Behind Cloudflare: the published
# Cloudflare ranges (https://www.cloudflare.com/ips/) or your own proxy's address/CIDR;
# "loopback" for a proxy on the same host; "false" only if the API is exposed directly.
TRUST_PROXY=<proxy CIDRs or addresses>
# HSTS on HTTPS requests (set by the trusted proxy); 0 disables it.
HSTS_MAX_AGE_SECONDS=15552000
# Internal API documentation stays off unless explicitly needed.
SWAGGER_ENABLED=false

# --- Abuse protection (cannot be disabled in staging) ---
AUTH_RATE_LIMIT=enabled
API_RATE_LIMIT=enabled
TURNSTILE_MODE=enforce
TURNSTILE_SECRET_KEY=<Cloudflare Turnstile secret of the staging widget (not a test key)>
TURNSTILE_EXPECTED_HOSTNAMES=<staging-frontend-host>

# --- Notifications and e-mail ---
# disabled (inbox only) | firebase (real pushes: also set STAGING_ALLOW_REAL_PUSH=true and FIREBASE_PROJECT_ID)
PUSH_DELIVERY_MODE=disabled
PUSH_WORKER_ENABLED=false
PUSH_REGISTRATION_KEYS=k1:<base64 of 32 random bytes>
PUSH_REGISTRATION_HASH_KEY=<base64 of >= 32 random bytes>
# disabled | smtp (file is refused in staging)
MAIL_TRANSPORT=disabled
# Required with smtp: https URL of the frontend used in reset/verification links (P3-BE12; never localhost)
# MAIL_LINK_BASE_URL=https://<staging-frontend-host>

# --- Observability ---
LOG_FORMAT=json
LOG_LEVEL=info
HEALTH_DB_TIMEOUT_MS=2000
