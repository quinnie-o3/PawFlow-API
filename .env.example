# Application (the frontend expects http://localhost:8000/api)
PORT=8000
# Frontend origin allowed by CORS (Next.js dev server)
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=pet_care_db

# Authentication
JWT_SECRET=your_jwt_secret
# Access-token lifetime and absolute refresh-session lifetime, in seconds (P3-BE01).
# JWT_EXPIRES_IN / JWT_EXPIRES_IN_SECONDS are not read by the application.
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000

# Business time zone: slot dates/times and "already started" checks use the
# process time zone. Set it in the environment if the host is not on Vietnam time.
# TZ=Asia/Ho_Chi_Minh

# Account recovery and e-mail verification (P3-BE02). Lifetimes in seconds.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Minimum interval between two e-mails of the same kind to one account.
AUTH_EMAIL_COOLDOWN_SECONDS=60
# Minimum duration of POST /auth/forgot-password in ms (hides whether an account exists).
AUTH_RECOVERY_MIN_RESPONSE_MS=250

# E-mail delivery: disabled (default: nothing is sent and issued links are
# revoked at once, so e-mail recovery is effectively off) | smtp | file (development only: writes each e-mail, including its
# link, as JSON to MAIL_OUTBOX_DIR; refused when NODE_ENV=production).
MAIL_TRANSPORT=disabled
MAIL_FROM=PawFlow <no-reply@pawflow.local>
# Base URL of the links in e-mails (defaults to FRONTEND_URL).
# MAIL_LINK_BASE_URL=http://localhost:3000
# MAIL_OUTBOX_DIR=./.tmp/mail-outbox  (git-ignored)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=

# Bot protection and rate limiting (P3-BE03) - see docs/phase3/bot-protection.md
# disabled | enforce. NODE_ENV=production refuses to start unless "enforce".
TURNSTILE_MODE=disabled
# Required with enforce. Never commit real secrets. Cloudflare test secret (non-production only):
# 1x0000000000000000000000000000000AA (always passes; reports hostname example.com, no action)
# TURNSTILE_SECRET_KEY=
# Comma-separated frontend hostnames allowed to issue tokens (required with enforce).
# TURNSTILE_EXPECTED_HOSTNAMES=localhost
# TURNSTILE_CHECK_ACTION=true
# TURNSTILE_TIMEOUT_MS=3000
# enabled (default) | disabled (non-production only)
AUTH_RATE_LIMIT=enabled
# Optional overrides, <limit>/<windowSeconds>:
# RATE_LIMIT_LOGIN_IP=20/300
# RATE_LIMIT_LOGIN_EMAIL=10/900
# RATE_LIMIT_REGISTER_IP=10/3600
# RATE_LIMIT_FORGOT_IP=10/900
# RATE_LIMIT_FORGOT_EMAIL=5/3600
# RATE_LIMIT_RESET_IP=10/900
# Reverse proxies allowed to set X-Forwarded-For: hop count or addresses/subnets. Unset = none.
# TRUST_PROXY=loopback
