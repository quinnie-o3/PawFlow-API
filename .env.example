# Application (the frontend expects http://localhost:8000/api)
PORT=8000
# Frontend origin allowed by CORS (Next.js dev server)
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=pet_care_db

# Authentication
JWT_SECRET=your_jwt_secret
# Token lifetime in seconds (JWT_EXPIRES_IN is not read by the application)
JWT_EXPIRES_IN_SECONDS=86400

# Business time zone: slot dates/times and "already started" checks use the
# process time zone. Set it in the environment if the host is not on Vietnam time.
# TZ=Asia/Ho_Chi_Minh
