# Application (the frontend expects http://localhost:8000/api)
PORT=8000
# Frontend origin allowed by CORS (Next.js dev server)
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=pet_care_db

# Authentication
JWT_SECRET=your_jwt_secret
# Access-token lifetime and absolute refresh-session lifetime, in seconds (P3-BE01).
# JWT_EXPIRES_IN / JWT_EXPIRES_IN_SECONDS are not read by the application.
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000

# Business time zone: slot dates/times and "already started" checks use the
# process time zone. Set it in the environment if the host is not on Vietnam time.
# TZ=Asia/Ho_Chi_Minh

# Account recovery and e-mail verification (P3-BE02). Lifetimes in seconds.
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Minimum interval between two e-mails of the same kind to one account.
AUTH_EMAIL_COOLDOWN_SECONDS=60
# Minimum duration of POST /auth/forgot-password in ms (hides whether an account exists).
AUTH_RECOVERY_MIN_RESPONSE_MS=250

# E-mail delivery: disabled (default: nothing is sent and issued links are
# revoked at once, so e-mail recovery is effectively off) | smtp | file (development only: writes each e-mail, including its
# link, as JSON to MAIL_OUTBOX_DIR; refused when NODE_ENV=production).
MAIL_TRANSPORT=disabled
MAIL_FROM=PawFlow <no-reply@pawflow.local>
# Base URL of the links in e-mails (defaults to FRONTEND_URL).
# MAIL_LINK_BASE_URL=http://localhost:3000
# MAIL_OUTBOX_DIR=./.tmp/mail-outbox  (git-ignored)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=

# Bot protection and rate limiting (P3-BE03) - see docs/phase3/bot-protection.md
# disabled | enforce. NODE_ENV=production refuses to start unless "enforce".
TURNSTILE_MODE=disabled
# Required with enforce. Never commit real secrets. Cloudflare test secret (non-production only):
# 1x0000000000000000000000000000000AA (always passes; reports hostname example.com, no action)
# TURNSTILE_SECRET_KEY=
# Comma-separated frontend hostnames allowed to issue tokens (required with enforce).
# TURNSTILE_EXPECTED_HOSTNAMES=localhost
# TURNSTILE_CHECK_ACTION=true
# TURNSTILE_TIMEOUT_MS=3000
# enabled (default) | disabled (non-production only)
AUTH_RATE_LIMIT=enabled
# Optional overrides, <limit>/<windowSeconds>:
# RATE_LIMIT_LOGIN_IP=20/300
# RATE_LIMIT_LOGIN_EMAIL=10/900
# RATE_LIMIT_REGISTER_IP=10/3600
# RATE_LIMIT_FORGOT_IP=10/900
# RATE_LIMIT_FORGOT_EMAIL=5/3600
# RATE_LIMIT_RESET_IP=10/900
# Reverse proxies allowed to set X-Forwarded-For: hop count or addresses/subnets. Unset = none.
# TRUST_PROXY=loopback

# Push device registrations (P3-BE05) - see docs/phase3/fcm-device-lifecycle.md
# Required when NODE_ENV=production; when unset elsewhere, development keys are derived from JWT_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PUSH_REGISTRATION_KEYS=k1:<base64 32 bytes>          # comma-separated; the first encrypts (rotation: prepend)
# PUSH_REGISTRATION_HASH_KEY=<base64, >= 32 bytes>     # never rotate
# PUSH_DEVICE_STALE_DAYS=30

# P3-BE06 push delivery outbox
# PUSH_DELIVERY_MODE=disabled          # disabled | mock (dev/QA only) | firebase. Unset -> disabled; REQUIRED explicitly when NODE_ENV=production or staging (mock refused)
# PUSH_DELIVERY_TTL_SECONDS=86400      # delivery deadline per job (60..2419200); undelivered jobs expire instead of sending late
# FIREBASE_PROJECT_ID=pawflow-dev       # required when PUSH_DELIVERY_MODE=firebase (one Firebase project per environment)
# PUSH_SEND_TIMEOUT_MS=10000           # bound for one provider call incl. the Admin SDK's internal retries (1000..60000)
# Firebase credentials are NOT configured in this file: the Admin SDK uses Application Default Credentials
# (attached service account / workload identity, or GOOGLE_APPLICATION_CREDENTIALS set by the runtime to a
# key file OUTSIDE the repository). Never commit a service-account JSON.
# PUSH_WORKER_ENABLED=false            # delivery worker; default false. true requires a push mode other than disabled AND the BE06-06 executor (refuses to start otherwise)
# PUSH_WORKER_BATCH_SIZE=5             # jobs claimed and executed concurrently per tick (1..50)
# PUSH_WORKER_POLL_MS=2000             # idle polling interval (200..60000); back-off up to 60 s after failed ticks
# PUSH_WORKER_LEASE_SECONDS=120        # job lease (10..3600, >= 3 x PUSH_SEND_TIMEOUT_MS), renewed every lease/3
# PUSH_WORKER_JOB_TIMEOUT_MS=60000     # bound for one job attempt (>= PUSH_SEND_TIMEOUT_MS)
# PUSH_DELIVERY_MAX_ATTEMPTS=8         # attempts per job (1..20)
# PUSH_RETRY_BASE_MS=30000             # first retry delay, doubles per attempt, +/-20 % jitter (1000..600000)
# PUSH_RETRY_MAX_MS=3600000            # backoff cap (>= base); Retry-After may exceed it; quota >= 60 s; config errors >= 5 min
# PUSH_WORKER_SHUTDOWN_GRACE_MS=10000  # wait for in-flight jobs on shutdown (0..60000)
